# Contraseña de la cuenta MySQL usada por los servicios PHP
DB_PASSWORD=storeapp_password

# Contraseña de administrador de MySQL (solo para administración de la BD)
MYSQL_ROOT_PASSWORD=root_storeapp_password

# development o production
APP_ENV=development

# Datos que se muestran para transferencias de demostración
STORE_TRANSFER_BANK=Banco de ejemplo
STORE_TRANSFER_BENEFICIARY=Beneficiario de ejemplo
STORE_TRANSFER_CLABE=000000000000000000
STORE_TRANSFER_ACCOUNT=0000000000
